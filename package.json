{
  "name": "kapitalradar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preregister": "tsx scripts/preregister.ts",
    "assignment": "tsx scripts/assignment.ts",
    "spike": "tsx scripts/spike.ts",
    "x1": "tsx scripts/x1.ts",
    "fixtures": "tsx scripts/fixtures.ts",
    "ingest": "tsx --env-file=.env.local scripts/ingest.ts",
    "history": "tsx --env-file=.env.local scripts/history.ts",
    "dev-eval": "tsx --env-file=.env.local scripts/dev-eval.ts",
    "classify": "tsx --env-file=.env.local scripts/classify.ts",
    "build-release": "tsx --env-file=.env.local scripts/build-release.ts",
    "unseal": "tsx --env-file=.env.local scripts/unseal.ts",
    "eval": "tsx --env-file=.env.local scripts/eval.ts",
    "leak-check": "tsx scripts/leak-check.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true
  }
}
